# ---------------------------------------------------------------- editor build
# Set to true to use the built-in client-side mock instead of a real AI.
# Any real Claude CLI or Ollama setup must leave this false.
NEXT_PUBLIC_AI_GATEWAY_MOCK=false

# Where the local AI connector answers.
#   unset      -> http://127.0.0.1:47821 (connector on the viewer's machine)
#   same-host  -> the origin that served this page
#   an origin  -> e.g. http://192.168.1.250:47821
# Use "same-host" when the AI lives on the server rather than on each viewer's
# machine, so one build works on every address the editor is reachable on.
NEXT_PUBLIC_AI_CONNECTOR_URL=same-host

# Port to append in same-host mode. Leave EMPTY when the connector is proxied
# under this app's own origin (see rewrites in next.config.ts) -- required for
# an HTTPS deployment, where a browser refuses to call a plain-http port.
NEXT_PUBLIC_AI_CONNECTOR_PORT=

# ------------------------------------------------------------------- connector
# Read by tools/local-ai-connector (and by ecosystem.config.cjs, which passes
# them through to the pm2 process). Changing these needs only a connector
# restart -- no rebuild, because nothing here is baked into the browser bundle:
#   pm2 restart technical-infographic-connector --update-env
#
# Which AI answers, in preference order. The first one is what "Auto" picks;
# every one listed still shows up in the editor's provider dropdown.
#   claude       Claude Code CLI login on this machine (subscription, no key)
#   local        a model served by Ollama / any OpenAI-compatible server
#   codex        Codex CLI login on this machine
#   gemini       Google AI Studio key -- enter it in Config, or set it below
#   api          ANTHROPIC_API_KEY
# e.g. "claude"  -> Claude CLI only
#      "local"   -> Ollama only
#      "claude,local" -> both, Claude by default
AI_BACKEND=claude,local,codex,gemini

# The local model server, used when "local" is listed above.
AI_BASE_URL=http://127.0.0.1:11434

# Default model. Claude CLI accepts default/sonnet/opus/haiku; Ollama takes a
# tag such as qwen3.6:35b. Leave unset to use each backend's own first choice.
# AI_MODEL=qwen3.6:35b

# Optional. The Gemini key can also be typed into Config -> AI connections, in
# which case it is held in the connector's memory and never written to disk.
# GEMINI_API_KEY=AIza...

# Absolute path to the Claude CLI, in case it is not on the pm2 process PATH.
CLAUDE_CLI=/home/anthu/.local/bin/claude
